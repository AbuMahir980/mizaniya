# Normalise line endings in the repository to LF, whatever the checkout platform.
# Without this, a Windows tool that rewrites a file flips it to CRLF and the next
# diff shows the whole file as changed, burying the real edit. Text files are
# detected automatically; the explicit entries below remove any doubt for the
# formats this repo actually carries.
* text=auto eol=lf

*.md    text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only scripts keep CRLF; PowerShell is happier with it.
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
