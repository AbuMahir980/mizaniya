{
  "name": "mizaniya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first household money app for salary-cycle budgeting, envelopes, and debts in both directions.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @mizaniya/web",
    "build": "npm run build -w @mizaniya/web",
    "preview": "npm run preview -w @mizaniya/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run naming && npm run spacing && npm run lint && npm run typecheck && npm run test && npm run build",
    "naming": "node scripts/check-naming.mjs",
    "peer-ai:check": "node peer-ai/check-upstream.mjs",
    "seed": "vite-node -c vitest.config.ts scripts/seed.ts",
    "spacing": "node scripts/check-spacing.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.11.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
